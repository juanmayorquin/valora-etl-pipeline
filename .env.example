# Copiá este archivo a `.env` y ajustá lo que necesites:
#
#     cp .env.example .env
#
# Sin `.env`, docker-compose usa exactamente estos valores. Son credenciales de
# desarrollo local: en un despliegue real salen de un gestor de secretos, no de acá.

# --- MinIO (el lago) ---
MINIO_ROOT_USER=valora
MINIO_ROOT_PASSWORD=valora123
MINIO_BUCKET=valora
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- ClickHouse (el warehouse) ---
CLICKHOUSE_USER=valora
CLICKHOUSE_PASSWORD=valora123
CLICKHOUSE_DB=valora
CLICKHOUSE_HTTP_PORT=8123
# 9000 en el host ya lo ocupa MinIO, por eso el nativo va en 9002
CLICKHOUSE_NATIVE_PORT=9002

# --- Jupyter (perfil `notebooks`) ---
JUPYTER_TOKEN=valora
JUPYTER_PORT=8888

# --- Interfaz web ---
WEB_PORT=8000

# --- Pipeline ---
# cada cuánto corre `pipeline-periodico`
INTERVALO_HORAS=24
# descargas en paralelo de la etapa detail
HILOS_DETALLE=8
