.claude/

# Notebooks
.ipynb_checkpoints/

# Salidas derivadas: se regeneran corriendo el pipeline, no se versionan.
#   data/processed/  -> lo produce src/transform.py
#   data/raw/historico/ -> snapshots de `extract.py --snapshot`, crecen sin techo
#   data/raw/detalle/ -> caché reanudable de src/detail.py; el detalle.parquet consolidado SÍ se versiona
#   models/predicciones_oof.parquet -> diagnóstico de src/train.py, se regenera; el modelo y su resumen SÍ se versionan
data/processed/
data/raw/historico/
data/raw/detalle/
models/predicciones_oof.parquet

# Archivos temporales que escribe el extract antes del os.replace atómico
*.tmp.csv
*.tmp.xlsx

# CatBoost escribe logs de entrenamiento en el cwd
catboost_info/

# Node / Frontend
node_modules/
**/node_modules/
dist/
**/dist/
.pnpm-store/
*.log
